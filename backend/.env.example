K13_DATA_SOURCE=demo
# 切换到 tushare 时，将 K13_DATA_SOURCE 改为 tushare，并填入你的 token
TUSHARE_TOKEN=your_tushare_token_here

# 可选：限定扫描股票池（逗号分隔，留空表示自动拉取上市股票并按 K13_SCAN_LIMIT 截断）
# K13_SYMBOLS=600519.SH,000858.SZ,300750.SZ

# 可选：自动扫描时的股票数量上限（仅当未配置 K13_SYMBOLS 时生效）
K13_SCAN_LIMIT=60

# 可选：默认回看交易日长度
K13_LOOKBACK_DAYS=260
